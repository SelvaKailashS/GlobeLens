# ==============================================================================
# TerraTrend Project Root .gitignore
# NASA Space Apps Challenge: Be an Earth Systems Trend Detective!
# ==============================================================================

# Node / Next.js Dependencies & Build Output
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
dist/
build/
coverage/
.vercel/

# TypeScript & Next build metadata
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Secrets & Credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python Bytecode, Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/*.egg-info/
*.egg-info/

# Earth Observation Data, Granules & Local Cache
data/raw/*
data/cache/*
!data/raw/.gitkeep
!data/cache/.gitkeep
backend/data/raw/*
backend/data/cache/*
!backend/data/raw/.gitkeep
!backend/data/cache/.gitkeep
*.nc
*.nc4
*.hdf
*.hdf5
*.h5
*.he5
*.tif
*.tiff
*.grib
*.grib2
*.tmp_download

# OS & IDE Temporary Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Automated browser verification test reports
browser-test-results.json
browser-verification-report.json
