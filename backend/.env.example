# TerraTrend Backend Environment Configuration
# Copy this file to .env and adjust variables as needed.
# NEVER commit the actual .env file or credentials to source control!

# Application Settings
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated for Next.js frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NASA Earthdata Login (URS) Credentials
# Required for downloading data from LP DAAC, GES DISC, and AppEEARS
# Register for a free account at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=

# Remote NASA Service Base URLs
APPEEARS_API_URL=https://appeears.earthdatacloud.nasa.gov/api/v1
GES_DISC_BASE_URL=https://disc.gsfc.nasa.gov
CMR_SEARCH_URL=https://cmr.earthdata.nasa.gov/search/granules.json

# Local Cache & Storage Paths
DATA_CACHE_DIR=data/cache
DATA_STORAGE_DIR=data/raw
